---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout>
	<PageHeader title="Blog" subtitle="Strength · Mobility · Recovery" />

	<main class="max-w-3xl mx-auto px-6 py-16 text-center">
		<p class="text-brand-cyan uppercase tracking-widest text-sm">Coming Soon</p>
		<h2 class="mt-4 font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
			Posts Are On The Way
		</h2>
		<p class="mt-6 text-brand-silver text-lg leading-relaxed">
			Tips on mobility, strength, recovery, and building a practice that lasts. Subscribe to hear when the first posts go live.
		</p>
		<a href="/subscribe" class="mt-10 inline-block bg-brand-cyan text-brand-black font-display font-bold uppercase tracking-widest text-sm px-8 py-4 hover:bg-white transition-colors">
			Subscribe
		</a>
	</main>
</Layout>

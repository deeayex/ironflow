---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout>
	<PageHeader title="Photos & Content" subtitle="On The Mat · In The Gym · At The Lake" />

	<main class="max-w-3xl mx-auto px-6 py-16 text-center">
		<p class="text-brand-cyan uppercase tracking-widest text-sm">Coming Soon</p>
		<h2 class="mt-4 font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
			The Gallery Is Being Built
		</h2>
		<p class="mt-6 text-brand-silver text-lg leading-relaxed">
			In the meantime, follow along on Instagram and Facebook for photos, videos, and class updates.
		</p>
		<div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
			<a href="https://www.instagram.com/ironflowwellness" target="_blank" rel="noopener noreferrer" class="inline-block bg-brand-cyan text-brand-black font-display font-bold uppercase tracking-widest text-sm px-8 py-4 hover:bg-white transition-colors">
				Instagram
			</a>
			<a href="https://www.facebook.com/share/1BfLuTqkZ1/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" class="inline-block border border-white/20 text-white font-display font-bold uppercase tracking-widest text-sm px-8 py-4 hover:border-brand-cyan hover:text-brand-cyan transition-colors">
				Facebook
			</a>
		</div>
	</main>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import { gallerySections } from '../data/photos';
---

<Layout>
	<PageHeader title="Photos & Content" subtitle="Studio · Lake · Rail Yard" />

	<main class="max-w-6xl mx-auto px-6 py-16">
		<!-- GALLERY: columns keep each photo's natural shape -->
		{gallerySections.map((section, i) => (
			<section class:list={[i > 0 && 'mt-20 border-t border-white/10 pt-16']}>
				<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-2 mb-8">
					<h2 class="section-title">{section.title}</h2>
					<p class="text-xs text-brand-silver uppercase tracking-widest">{section.credit}</p>
				</div>
				<div class="columns-1 sm:columns-2 lg:columns-3 gap-5">
					{section.photos.map(photo => (
						<figure class="mb-5 break-inside-avoid overflow-hidden rounded-xl border border-white/10">
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[480, 800, 1200]}
								sizes="(min-width: 1024px) 370px, (min-width: 640px) 50vw, 100vw"
								class="w-full h-auto hover:scale-[1.02] transition-transform duration-500"
							/>
						</figure>
					))}
				</div>
			</section>
		))}

		<!-- SOCIAL -->
		<section class="mt-20 border-t border-white/10 pt-16 text-center">
			<p class="eyebrow">Follow Along</p>
			<h2 class="mt-3 section-title">More On Social</h2>
			<p class="mt-4 text-brand-silver text-lg max-w-xl mx-auto leading-relaxed">
				Class moments, videos, and studio updates on Instagram and Facebook.
			</p>
			<div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
				<a href="https://www.instagram.com/ironflowwellness" target="_blank" rel="noopener noreferrer" class="btn-primary">Instagram</a>
				<a href="https://www.facebook.com/share/1BfLuTqkZ1/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" class="btn-secondary">Facebook</a>
			</div>
		</section>
	</main>
</Layout>

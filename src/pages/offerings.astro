---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import OfferingTreeEmbed from '../components/OfferingTreeEmbed.astro';

// Class names, locations and descriptions match OfferingTree
// (ironflow.offeringtree.com/offerings). Days and times live on the schedule.
const classes = [
	{
		name: 'Rise and Flow',
		where: 'Iron Flow Studio or Virtual · 45 min',
		description: 'Start your day with intentional movement, breath, and energy. An all-levels morning yoga class designed to gently wake up the body, improve mobility and flexibility, build stability, and prepare you for the day ahead.',
	},
	{
		name: 'Lunch Time Power Flow',
		where: 'Metroflex Ardmore or Virtual · 40 min',
		description: 'A midday power flow from 12:10 to 12:50 PM. Refresh, refocus, and recharge with a focused class to build strength, improve mobility, and power through your day.',
	},
	{
		name: 'Post Work Day Flow',
		where: 'Iron Flow Studio or Virtual · 60 min',
		description: 'Unwind, stretch, and reset after work. Release tension and recharge your body and mind.',
	},
	{
		name: 'Full Body Flow',
		where: 'Iron Flow Studio or Virtual · 60 min',
		description: 'An all-levels yoga class designed to move the entire body through a balanced combination of strength, mobility, flexibility, balance, and breathwork.',
	},
	{
		name: 'Reset and Restore',
		where: 'Iron Flow Studio or Virtual · Sunday evenings · 60 min',
		description: 'End the weekend with intentional movement and a chance to slow down. A calming, all-levels class focused on gentle stretching, mobility, breathwork, and relaxation to prepare your body and mind for the week ahead.',
	},
];

const more = [
	{ name: 'Private Yoga Instruction', description: 'A personalized one-on-one experience designed around your body, goals, experience level, and comfort.' },
	{ name: 'Private Meditation Session', description: 'A quiet, individualized space to slow down, breathe, and reconnect. No experience needed.' },
	{ name: 'Personal Training', description: 'One-on-one training at Metroflex, or privately at the Main Rail studio and select outdoor locations.' },
	{ name: 'Specialty Classes & Events', description: 'Private, outdoor, and boat yoga for small groups, events, and special occasions. Pricing on request.' },
];
---

<Layout>
	<PageHeader title="Offerings" subtitle="Yoga · Mobility · Strength · Recovery" />

	<main class="max-w-6xl mx-auto px-6 py-16">
		<!-- INTRO -->
		<div class="text-center max-w-2xl mx-auto">
			<p class="text-brand-silver text-lg leading-relaxed">
				Every class is built for every level. Whether you're brand new or a seasoned athlete, there's a place for you on the mat.
				All fitness levels welcome — you do not need to be fit before you start.
			</p>
		</div>

		<!-- CLASSES -->
		<div class="mt-16">
			<p class="text-brand-cyan uppercase tracking-widest text-sm text-center">Studio · Metroflex · Virtual</p>
			<h2 class="mt-4 font-display text-3xl md:text-4xl font-bold tracking-tight uppercase text-center">
				Classes
			</h2>
			<p class="mt-2 text-brand-silver text-center text-sm">Semi-private studio classes are limited to 3 people.</p>
			<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{classes.map(cls => (
					<div class="border border-white/10 p-8 hover:border-brand-cyan transition-colors">
						<h3 class="font-display text-2xl font-bold uppercase tracking-widest">{cls.name}</h3>
						<p class="mt-3 text-brand-cyan uppercase tracking-widest text-xs">{cls.where}</p>
						<p class="mt-5 text-brand-silver leading-relaxed">{cls.description}</p>
					</div>
				))}
			</div>
			<div class="mt-10 text-center">
				<a href="/#schedule" class="text-brand-cyan uppercase tracking-widest text-sm hover:text-white transition-colors">
					See this week's schedule →
				</a>
			</div>
		</div>

		<!-- MORE WAYS -->
		<div class="mt-24">
			<h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight uppercase text-center">
				Private Sessions &amp; Specialty
			</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				{more.map(item => (
					<div class="border border-white/10 p-6 hover:border-brand-cyan transition-colors">
						<h3 class="font-display text-lg font-bold uppercase tracking-widest">{item.name}</h3>
						<p class="mt-3 text-sm text-brand-silver leading-relaxed">{item.description}</p>
					</div>
				))}
			</div>
		</div>

		<!-- OFFERINGTREE -->
		<div class="mt-24 border-t border-white/10 pt-16 text-center">
			<h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
				Book Your Spot
			</h2>
			<p class="mt-4 text-brand-silver text-lg">
				300 E Main, Suite 5, Ardmore, OK
			</p>
			<div class="mt-10 max-w-3xl mx-auto">
				<OfferingTreeEmbed path="offerings" id="ot-offerings-embed" title="Iron Flow offerings" maxHeight={720} />
			</div>
			<p class="mt-10 text-brand-silver">
				Looking for pricing? <a href="/packages" class="text-brand-cyan hover:text-white transition-colors">See packages &amp; memberships →</a>
			</p>
		</div>
	</main>
</Layout>

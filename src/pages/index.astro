---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import OfferingTreeEmbed from '../components/OfferingTreeEmbed.astro';

const ways = [
	{
		name: 'Live Classes',
		description: 'Yoga, mobility, and strength flows in person at Metroflex, downtown Ardmore, and the lake, or live from home over Zoom.',
		cta: 'Sign me up',
		href: '/offerings',
	},
	{
		name: 'On-Demand',
		description: 'A library of recorded classes you can stream anytime, included with every monthly membership.',
		cta: 'Join now',
		href: '/packages',
	},
	{
		name: 'Privates',
		description: 'One-on-one, partner, and small-group personal training built around your goals and your pace.',
		cta: 'Learn more',
		href: '/packages#personal-training',
	},
];
---

<Layout>
	<!-- HERO -->
	<section class="min-h-[80vh] flex items-center justify-center px-6 py-20">
		<div class="max-w-3xl text-center">
			<Image src={logo} alt="Iron Flow Wellness" width={320} height={320} class="mx-auto rounded-full" />
			<p class="mt-8 text-brand-cyan uppercase tracking-widest text-sm">Move With Purpose</p>
			<h1 class="mt-4 font-display text-4xl md:text-5xl font-bold tracking-tight uppercase">
				Where Strength Meets Mobility
			</h1>
			<p class="mt-6 text-brand-silver text-lg leading-relaxed">
				Yoga, mobility, strength, and recovery. Built for every body, from brand new to seasoned athlete.
			</p>
			<div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
				<a href="#schedule" class="inline-block bg-brand-cyan text-brand-black font-display font-bold uppercase tracking-widest text-sm px-8 py-4 hover:bg-white transition-colors">
					View Schedule
				</a>
				<a href="/offerings" class="inline-block border border-white/20 text-white font-display font-bold uppercase tracking-widest text-sm px-8 py-4 hover:border-brand-cyan hover:text-brand-cyan transition-colors">
					Explore Offerings
				</a>
			</div>
		</div>
	</section>

	<!-- NEW MEMBER OFFER -->
	<section class="bg-brand-cyan text-brand-black px-6 py-8">
		<div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
			<p class="font-display text-xl md:text-2xl font-bold uppercase tracking-wide">
				New here? Get introductory membership pricing for your first 3 months.
			</p>
			<a href="/packages" class="inline-block bg-brand-black text-white font-display font-bold uppercase tracking-widest text-sm px-8 py-4 hover:bg-white hover:text-brand-black transition-colors whitespace-nowrap">
				See Memberships
			</a>
		</div>
	</section>

	<!-- LIVE SCHEDULE -->
	<section id="schedule" class="py-20 px-6 scroll-mt-4">
		<div class="max-w-4xl mx-auto">
			<div class="text-center">
				<p class="text-brand-cyan uppercase tracking-widest text-sm">This Week</p>
				<h2 class="mt-4 font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
					Live Class Schedule
				</h2>
				<p class="mt-4 text-brand-silver">Pick a class and register right here.</p>
			</div>
			<div class="mt-10">
				<OfferingTreeEmbed path="schedule" id="ot-schedule-embed" title="Iron Flow live class schedule" height={900} />
			</div>
			<div class="mt-8 text-center">
				<a href="https://ironflow.offeringtree.com/schedule" target="_blank" rel="noopener noreferrer" class="text-brand-cyan uppercase tracking-widest text-sm hover:text-white transition-colors">
					View full schedule →
				</a>
			</div>
		</div>
	</section>

	<!-- MISSION -->
	<section class="border-t border-white/10 py-20 px-6">
		<div class="max-w-3xl mx-auto text-center">
			<p class="text-brand-cyan uppercase tracking-widest text-sm">The Vision</p>
			<h2 class="mt-4 font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
				You Don't Have To Choose
			</h2>
			<div class="mt-8 text-brand-silver text-lg leading-relaxed space-y-4">
				<p>Between being strong and being agile.</p>
				<p>Between lifting heavy and moving well.</p>
				<p>Between building muscle and finding peace.</p>
				<p class="pt-4 text-white">
					Iron Flow brings it all together. Fitness meets recovery, strength meets stillness, and every body is welcome at every level.
				</p>
			</div>
		</div>
	</section>

	<!-- THREE WAYS TO TRAIN -->
	<section class="border-t border-white/10 py-20 px-6">
		<div class="max-w-6xl mx-auto">
			<div class="text-center">
				<p class="text-brand-cyan uppercase tracking-widest text-sm">What We Offer</p>
				<h2 class="mt-4 font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
					Three Ways To Train
				</h2>
			</div>
			<div class="mt-12 grid gap-6 md:grid-cols-3">
				{ways.map(way => (
					<div class="border border-white/10 p-8 text-center hover:border-brand-cyan transition-colors flex flex-col">
						<h3 class="font-display text-xl font-bold uppercase tracking-widest">{way.name}</h3>
						<p class="mt-3 text-sm text-brand-silver leading-relaxed flex-1">{way.description}</p>
						<a href={way.href} class="mt-6 text-brand-cyan uppercase tracking-widest text-xs hover:text-white transition-colors">
							{way.cta} →
						</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- VALUES / SCRIPTURE -->
	<section class="border-t border-white/10 py-20 px-6">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
				Faith. Strength. Purpose.
			</h2>
			<p class="mt-6 text-brand-silver text-lg leading-relaxed">
				Iron Flow is built on the belief that faith and fitness belong together. Strengthen your body, calm your mind, fuel your purpose.
			</p>
			<p class="mt-10 font-display italic text-brand-cyan text-xl">
				"Iron sharpens iron."
			</p>
			<p class="mt-2 text-brand-silver text-sm uppercase tracking-widest">
				Proverbs 27:17
			</p>
		</div>
	</section>

	<!-- CTA -->
	<section class="border-t border-white/10 py-20 px-6">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
				Join The Movement
			</h2>
			<p class="mt-4 text-brand-silver text-lg">
				Located at Metroflex Gym in Ardmore, OK.
			</p>
			<a href="/contact" class="mt-8 inline-block bg-brand-cyan text-brand-black font-display font-bold uppercase tracking-widest text-sm px-8 py-4 hover:bg-white transition-colors">
				Get In Touch
			</a>
		</div>
	</section>
</Layout>
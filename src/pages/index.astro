---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import OfferingTreeEmbed from '../components/OfferingTreeEmbed.astro';

// Where the "Watch On Demand" button goes (Brandi's OfferingTree video library).
const onDemandUrl = 'https://ironflow.offeringtree.com/online_store';

const ways = [
	{
		name: 'Live Classes',
		description: 'Yoga, mobility, and strength flows at Iron Flow Studio and Metroflex, or live from home over Zoom.',
		cta: 'See offerings',
		href: '/offerings',
	},
	{
		name: 'On-Demand',
		description: 'Recorded classes you can stream anytime, included with every monthly membership.',
		cta: 'Watch now',
		href: '#on-demand',
	},
	{
		name: 'Personal Training',
		description: 'One-on-one, partner, and small-group training built around your goals and your pace.',
		cta: 'See rates',
		href: '/packages#personal-training',
	},
];
---

<Layout>
	<!-- HERO -->
	<section class="px-6 py-16 md:py-24">
		<div class="max-w-6xl mx-auto grid gap-12 md:grid-cols-2 items-center">
			<div class="text-center md:text-left order-2 md:order-1">
				<p class="eyebrow">Move With Purpose</p>
				<h1 class="mt-4 font-display text-5xl lg:text-6xl font-bold tracking-tight uppercase leading-[1.05]">
					Where Strength<br class="hidden md:block" /> Meets Mobility
				</h1>
				<p class="mt-6 text-brand-silver text-lg leading-relaxed max-w-md mx-auto md:mx-0">
					Yoga, mobility, strength, and recovery in Ardmore, OK. Built for every body, from brand new to seasoned athlete.
				</p>
				<div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
					<a href="#schedule" class="btn-primary">View Schedule</a>
					<a href="/packages" class="btn-secondary">Memberships</a>
				</div>
				<p class="mt-6 text-sm text-brand-silver">
					New here? <a href="/packages" class="text-brand-cyan hover:text-white transition-colors">Intro pricing for your first 3 months →</a>
				</p>
			</div>
			<div class="order-1 md:order-2 flex justify-center">
				<Image src={logo} alt="Iron Flow Health & Wellness" width={420} height={420} class="w-56 md:w-full max-w-sm rounded-full" loading="eager" />
			</div>
		</div>
	</section>

	<!-- THREE WAYS TO TRAIN -->
	<section class="px-6 py-16 md:py-20 border-t border-white/10">
		<div class="max-w-6xl mx-auto">
			<p class="eyebrow">What We Offer</p>
			<h2 class="mt-3 section-title">Three Ways To Train</h2>
			<div class="mt-10 grid gap-5 md:grid-cols-3">
				{ways.map((way, i) => (
					<a href={way.href} class="group rounded-xl border border-white/10 bg-white/[0.03] p-7 flex flex-col hover:border-brand-cyan transition-colors">
						<span class="font-display text-brand-cyan text-sm">0{i + 1}</span>
						<h3 class="mt-2 font-display text-2xl font-bold uppercase tracking-wide">{way.name}</h3>
						<p class="mt-3 text-brand-silver leading-relaxed flex-1">{way.description}</p>
						<span class="mt-6 text-link group-hover:text-white">{way.cta} →</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- LIVE SCHEDULE -->
	<section id="schedule" class="px-6 py-16 md:py-20 border-t border-white/10 scroll-mt-4">
		<div class="max-w-6xl mx-auto">
			<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
				<div>
					<p class="eyebrow">This Week</p>
					<h2 class="mt-3 section-title">Class Schedule</h2>
					<p class="mt-3 text-brand-silver">Pick a class and register right here. Scroll inside the schedule to see more.</p>
				</div>
				<a href="https://ironflow.offeringtree.com/schedule" target="_blank" rel="noopener noreferrer" class="text-link whitespace-nowrap">
					Open full schedule →
				</a>
			</div>
			<div class="mt-8">
				<OfferingTreeEmbed path="schedule" id="ot-schedule-embed" title="Iron Flow class schedule" height={640} maxHeight={640} />
			</div>
		</div>
	</section>

	<!-- ON DEMAND -->
	<section id="on-demand" class="px-6 py-16 md:py-20 border-t border-white/10 scroll-mt-4">
		<div class="max-w-6xl mx-auto rounded-2xl border border-brand-cyan/30 bg-gradient-to-br from-brand-cyan/15 to-transparent p-8 md:p-12 grid gap-8 md:grid-cols-[1fr_auto] items-center">
			<div>
				<p class="eyebrow">Can't Make It To Class?</p>
				<h2 class="mt-3 section-title">Watch On Demand</h2>
				<p class="mt-4 text-brand-silver text-lg leading-relaxed max-w-xl">
					Stream recorded Iron Flow classes from home or on the go. Included with every monthly membership.
				</p>
			</div>
			<div class="flex flex-col gap-3">
				<a href={onDemandUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Video Library</a>
				<a href="/packages" class="btn-secondary">See Memberships</a>
			</div>
		</div>
	</section>

	<!-- APPROACH + FAITH -->
	<section class="px-6 py-16 md:py-20 border-t border-white/10">
		<div class="max-w-6xl mx-auto grid gap-12 md:grid-cols-2 items-center">
			<div>
				<p class="eyebrow">The Vision</p>
				<h2 class="mt-3 section-title">You Don't Have To Choose</h2>
				<p class="mt-5 text-brand-silver text-lg leading-relaxed">
					Between being strong and being agile. Between lifting heavy and moving well. Between building muscle and finding peace.
				</p>
				<p class="mt-4 text-white text-lg leading-relaxed">
					Iron Flow brings it all together. Fitness meets recovery, strength meets stillness, and every body is welcome at every level.
				</p>
			</div>
			<div class="rounded-2xl border border-white/10 p-8 md:p-10 text-center">
				<p class="font-display text-2xl font-bold uppercase tracking-wide">Faith. Strength. Purpose.</p>
				<p class="mt-6 font-display italic text-brand-cyan text-3xl">"Iron sharpens iron."</p>
				<p class="mt-2 text-brand-silver text-xs uppercase tracking-widest">Proverbs 27:17</p>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="px-6 py-16 md:py-20 border-t border-white/10">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="section-title">Join The Movement</h2>
			<p class="mt-4 text-brand-silver text-lg">
				Classes at Iron Flow Studio (The Main Rail, downtown) and Metroflex in Ardmore, OK, or live online.
			</p>
			<div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
				<a href="#schedule" class="btn-primary">Book A Class</a>
				<a href="/contact" class="btn-secondary">Get In Touch</a>
			</div>
		</div>
	</section>
</Layout>

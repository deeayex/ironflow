---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout>
	<PageHeader title="Contact" subtitle="Join The Movement" />

	<main class="max-w-6xl mx-auto px-6 py-16">
		<!-- INTRO -->
		<div class="text-center max-w-2xl mx-auto">
			<p class="text-brand-silver text-lg leading-relaxed">
				Ready to move with purpose? Reach out and let's talk about how Iron Flow can fit into your journey.
			</p>
		</div>

		<!-- CONTACT GRID -->
		<div class="mt-16 grid gap-6 md:grid-cols-2">

			<!-- Phone -->
			<a href="tel:+16202903378" class="group border border-white/10 p-8 hover:border-brand-cyan transition-colors">
				<div class="flex items-center gap-4">
					<svg class="w-8 h-8 text-brand-cyan" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
					</svg>
					<h2 class="font-display text-xl font-bold uppercase tracking-widest">Call or Text</h2>
				</div>
				<p class="mt-6 text-brand-silver text-lg group-hover:text-white transition-colors">
					(620) 290-3378
				</p>
			</a>

			<!-- Email -->
			<a href="mailto:Bkelty@ironflowwellness.com" class="group border border-white/10 p-8 hover:border-brand-cyan transition-colors">
				<div class="flex items-center gap-4">
					<svg class="w-8 h-8 text-brand-cyan" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
					</svg>
					<h2 class="font-display text-xl font-bold uppercase tracking-widest">Email</h2>
				</div>
				<p class="mt-6 text-brand-silver text-lg group-hover:text-white transition-colors break-all">
					Bkelty@ironflowwellness.com
				</p>
			</a>

			<!-- Instagram -->
				<a href="https://www.instagram.com/ironflowwellness" target="_blank" rel="noopener noreferrer" class="group border border-white/10 p-8 hover:border-brand-cyan transition-colors">				<div class="flex items-center gap-4">
					<svg class="w-8 h-8 text-brand-cyan" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
						<rect x="3" y="3" width="18" height="18" rx="5" />
						<circle cx="12" cy="12" r="4" />
						<circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
					</svg>
					<h2 class="font-display text-xl font-bold uppercase tracking-widest">Instagram</h2>
				</div>
				<p class="mt-6 text-brand-silver text-lg group-hover:text-white transition-colors">
					@ironflowwellness
				</p>
			</a>

			<!-- Facebook -->
			<a href="https://www.facebook.com/share/1BfLuTqkZ1/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" class="group border border-white/10 p-8 hover:border-brand-cyan transition-colors">
				<div class="flex items-center gap-4">
					<svg class="w-8 h-8 text-brand-cyan" fill="currentColor" viewBox="0 0 24 24">
						<path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
					</svg>
					<h2 class="font-display text-xl font-bold uppercase tracking-widest">Facebook</h2>
				</div>
				<p class="mt-6 text-brand-silver text-lg group-hover:text-white transition-colors">
					Iron Flow Wellness
				</p>
			</a>

		</div>

		<!-- LOCATION -->
		<div class="mt-16 border-t border-white/10 pt-16 text-center">
			<p class="text-brand-cyan uppercase tracking-widest text-sm">Find Us</p>
			<h2 class="mt-4 font-display text-3xl md:text-4xl font-bold tracking-tight uppercase">
				Metroflex Gym
			</h2>
			<p class="mt-4 text-brand-silver text-lg">Ardmore, OK</p>
		</div>

		<!-- CLOSING -->
		<div class="mt-20 text-center">
			<p class="font-display italic text-brand-cyan text-xl">
				"Let's Flow. See you on the mat."
			</p>
		</div>
	</main>
</Layout>
---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/classes', label: 'Classes' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-white/10 bg-brand-black">
	<div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
		<a href="/" class="flex items-center gap-3">
			<Image src={logo} alt="Iron Flow Wellness" width={48} height={48} class="rounded-full" />
			<span class="font-display font-bold text-xl tracking-wide">IRON FLOW WELLNESS</span>
		</a>
		<nav>
			<ul class="flex gap-8">
				{navLinks.map(link => (
					<li>
						<a href={link.href} class="text-sm uppercase tracking-widest text-brand-silver hover:text-brand-cyan transition-colors">
							{link.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</header>
---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/instructor', label: 'Instructor' },
	{ href: '/offerings', label: 'Offerings' },
	{ href: '/packages', label: 'Packages & Memberships' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/contact', label: 'Contact' },
	{ href: '/photos', label: 'Photos & Content' },
];

// Highlight the link for the page we're on
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---

<header class="border-b border-white/10 bg-brand-black relative">
	<div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
		<a href="/" class="flex items-center gap-3">
			<Image src={logo} alt="Iron Flow Wellness" width={48} height={48} class="rounded-full" />
			<span class="font-display font-bold text-base md:text-xl tracking-wide">IRON FLOW WELLNESS</span>
		</a>

		<div class="flex items-center gap-4">
			<!-- Subscribe button (desktop) -->
			<a href="/subscribe" class="hidden lg:inline-block bg-brand-cyan text-brand-black font-display font-bold uppercase tracking-widest text-xs px-5 py-3 hover:bg-white transition-colors">
				Subscribe
			</a>

			<!-- Mobile hamburger button (shown below lg) -->
			<button id="menu-toggle" class="lg:hidden text-white p-2 -mr-2" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Desktop nav: its own row so all the tabs fit -->
	<nav class="hidden lg:block border-t border-white/10">
		<ul class="max-w-6xl mx-auto px-6 py-3 flex justify-center gap-7">
			{navLinks.map(link => (
				<li>
					<a
						href={link.href}
						class:list={[
							'text-xs uppercase tracking-widest transition-colors whitespace-nowrap hover:text-brand-cyan',
							isActive(link.href) ? 'text-brand-cyan' : 'text-brand-silver',
						]}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>

	<!-- Mobile menu (hidden by default, shown when toggled) -->
	<nav id="mobile-menu" class="hidden lg:hidden border-t border-white/10">
		<ul class="flex flex-col px-6 py-4 space-y-4">
			{navLinks.map(link => (
				<li>
					<a
						href={link.href}
						class:list={[
							'block text-sm uppercase tracking-widest transition-colors hover:text-brand-cyan',
							isActive(link.href) ? 'text-brand-cyan' : 'text-brand-silver',
						]}
					>
						{link.label}
					</a>
				</li>
			))}
			<li class="pt-2">
				<a href="/subscribe" class="inline-block bg-brand-cyan text-brand-black font-display font-bold uppercase tracking-widest text-sm px-6 py-3 hover:bg-white transition-colors">
					Subscribe
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	toggle?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', String(open));
	});
</script>

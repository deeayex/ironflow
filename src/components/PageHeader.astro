---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="border-b border-white/10 py-20">
	<div class="max-w-6xl mx-auto px-6 text-center">
		<h1 class="font-display text-5xl md:text-6xl font-bold tracking-tight uppercase">{title}</h1>
		{subtitle && (
			<p class="mt-4 text-brand-cyan uppercase tracking-widest text-sm">{subtitle}</p>
		)}
	</div>
</section>
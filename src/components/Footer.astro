---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-brand-black mt-24">
	<div class="max-w-6xl mx-auto px-6 py-12 grid gap-8 md:grid-cols-3">
		<div>
			<h3 class="font-display text-lg tracking-widest text-brand-cyan uppercase">Iron Flow Wellness</h3>
			<p class="mt-3 text-sm text-brand-silver leading-relaxed">
				Strength meets mobility.<br />
				Faith. Strength. Purpose.
			</p>
		</div>

		<div>
			<h3 class="font-display text-lg tracking-widest text-brand-cyan uppercase">Find Us</h3>
			<p class="mt-3 text-sm text-brand-silver leading-relaxed">
				Metroflex Gym<br />
				Ardmore, OK
			</p>
		</div>

		<div>
			<h3 class="font-display text-lg tracking-widest text-brand-cyan uppercase">Connect</h3>
			<a
				href="https://instagram.com/ironflow.wellness"
				target="_blank"
				rel="noopener noreferrer"
				class="mt-3 inline-block text-sm text-brand-silver hover:text-brand-cyan transition-colors"
			>
            
				@ironflow.wellness
			</a>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="max-w-6xl mx-auto px-6 py-6 flex flex-col md:flex-row justify-between text-xs text-brand-silver/60">
			<p>© {year} Iron Flow Wellness. All rights reserved.</p>
			<p class="mt-2 md:mt-0 italic">"Iron sharpens iron." — Proverbs 27:17</p>
		</div>
	</div>
</footer>